--- what each VM started from
== snippet-1.mode
600
== snippet-1.yaml
#cloud-config
hostname: ci-a-1
write_files:
  - path: /usr/local/sbin/mayfly-pod
    permissions: '0755'
    encoding: b64
    content: IyEvYmluL3NoCmVjaG8gcG9kCg==
  - path: /etc/mayfly/pod.env
    permissions: '0600'
    content: |
      CONTAINERS=4
      CPUS=2.00
      MEMORY=2g
      MAX_JOB_SECS=10800
      MAX_IDLE_SECS=7200
  - path: /etc/mayfly/job.env
    permissions: '0600'
    content: |
      A=1
      B=two
runcmd:
  - [bash, -c, '/usr/local/sbin/mayfly-pod image > /var/log/mayfly-pod-image.log 2>&1']
== fw-1.fw
[OPTIONS]
enable: 1
dhcp: 1
policy_in: DROP
policy_out: ACCEPT

[RULES]
OUT ACCEPT -dest 10.0.0.1 -p udp -dport 53
OUT ACCEPT -dest 10.0.0.1 -p tcp -dport 53
OUT ACCEPT -dest 10.0.0.5
OUT DROP -dest 10.0.0.0/8
OUT DROP -dest 172.16.0.0/12
OUT DROP -dest 192.168.0.0/16
OUT DROP -dest 100.64.0.0/10
OUT DROP -dest 169.254.0.0/16
== put-1
mf-a-1-1-EPOCH JITSECRET-77
== put-2
