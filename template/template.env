# Core settings baked into every template. A profile's template.env is read after this one and may
# override any of them. Bump here, then `mayfly template build`.
# The runner tarball is checked against the SHA the actions/runner release notes list for linux-x64.
RUNNER_VERSION=2.338.2
# Docker engine (+ buildx, compose) and the GitHub CLI from their apt repositories.
INSTALL_DOCKER=yes
INSTALL_GH=yes
# Pulled into the template so jobs start without downloading them (needs INSTALL_DOCKER=yes).
PREPULL_IMAGES=""
